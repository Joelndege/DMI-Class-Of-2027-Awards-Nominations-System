# Local development defaults only. Do not use this file as production secrets.
DEBUG=True
SECRET_KEY=replace-with-a-random-local-development-key
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional locally; on Railway, link a PostgreSQL service and set DATABASE_URL
# to its connection URL (for example, ${{Postgres.DATABASE_URL}}).
# DATABASE_URL=

# Optional OAuth credentials. Google login is not currently enabled in the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
